OPENAI_API_KEY=sk-...

# Leave CONTENT_AGENT_DB_PATH unset -- it defaults correctly on its own:
# ./content_agent.db for local dev, /data/content_agent.db in Docker (set by
# the Dockerfile). Setting it here would override the Docker default via
# --env-file and write the DB outside the mounted volume.

# shared login password for the Gradio UI -- one password for all clients, v1 only
CONTENT_AGENT_SHARED_PASSWORD=changeme

# optional, defaults shown
CONTENT_AGENT_HOST=0.0.0.0
CONTENT_AGENT_PORT=7860
